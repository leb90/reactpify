{% comment %}
  REACTPIFY-AUTOGEN
  Generated from src/components/test/Test.tsx. Edits are overwritten on every build.
  Delete this comment block to take ownership of the file.
{% endcomment %}

<div
  class="reactpify-section test-section color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-component-root="Test"
>
  <script type="application/json" data-section-data>
    {
      "title": {{ section.settings.title | json }},
      "showButton": {{ section.settings.show_button | json }}
    }
  </script>

  <div data-fallback>
    {%- if section.settings.title != blank -%}
      <h2>{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Test",
  "tag": "section",
  "class": "shopify-section--reactpify",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Hello World"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    FRAGMENT.color-scheme,
    FRAGMENT.section-spacing
  ],
  "presets": [
    {
      "name": "Test"
    }
  ]
}
{% endschema %}
