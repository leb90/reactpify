{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/utils/components/*"],
      "@helpers/*": ["src/utils/helpers/*"],
      "@interfaces/*": ["src/utils/interfaces/*"],
      "@redux/*": ["src/redux/*"],
      "@src/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "vite-plugins/**/*", "vite.config.ts", "vite-fragment-injection.ts"],
  "exclude": [
    "node_modules",
    "assets",
    "sections",
    "snippets",
    "templates",
    "layout",
    "blocks",
    "config",
    "locales"
  ]
}
